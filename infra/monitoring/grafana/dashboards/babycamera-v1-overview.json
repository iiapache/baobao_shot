      "id": 1,
      "title": "API 概览（RPS / P95 / 5xx）",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=~\"$service\", region=~\"$region\"}[5m])) by (service_name)",
          "legendFormat": "{{service_name}} (OTEL)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(babycamera_http_requests_total{service=~\"$service\", region=~\"$region\"}[5m])) by (service)",
          "legendFormat": "{{service}} (/metrics)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(apisix_http_status{service=~\".*gateway.*\"}[5m])) by (service)",
          "legendFormat": "{{service}} (Gateway)",
          "refId": "C"
        }
      ],
      "title": "API RPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=~\"$service\", region=~\"$region\"}[5m])) by (le, service_name)) / 1000",
          "legendFormat": "P95 {{service_name}} (OTEL)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(babycamera_http_request_duration_seconds_bucket{service=~\"$service\", region=~\"$region\"}[5m])) by (le, service))",
          "legendFormat": "P95 {{service}} (/metrics)",
          "refId": "B"
        }
      ],
      "title": "API P95 延迟",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=~\"$service\", http_status_code=~\"5..\", region=~\"$region\"}[5m])) by (service_name, http_status_code)",
