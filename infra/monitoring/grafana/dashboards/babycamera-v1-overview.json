          "refId": "B"
        },
        {
          "expr": "sum(rate(apisix_http_status{code=~\"5..\"}[5m])) by (code, route)",
          "legendFormat": "gateway {{route}} {{code}}",
          "refId": "C"
        }
      ],
      "title": "5xx 错误率 (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" },
