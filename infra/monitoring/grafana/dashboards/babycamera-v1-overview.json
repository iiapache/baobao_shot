      },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=~\"$service\", http_status_code=~\"5..\", region=~\"$region\"}[5m])) by (service_name) / sum(rate(traces_spanmetrics_calls_total{service_name=~\"$service\", region=~\"$region\"}[5m])) by (service_name)",
