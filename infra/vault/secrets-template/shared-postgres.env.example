# 共享 PostgreSQL 凭据模板（与 infra/data/postgresql 对齐）
# Vault path: secret/data/{env}/{region}/shared/postgres-{service}
#
# K8s Secret 名称（Bitnami Chart）: baobao-postgresql
# Secret keys: postgres-password（superuser）, password（应用用户 baobao）
#
# 写入示例:
#   vault kv put secret/dev/cn/shared/postgres-auth-family \
#     host="postgresql.dev.svc.cluster.local" \
#     port="5432" \
#     database="baobao" \
#     username="baobao" \
#     password="REPLACE_ME" \
#     postgres_password="REPLACE_ME"

# --- 路径与服务映射（与 policies/*.hcl 一致）---
# secret/data/{env}/cn/shared/postgres-auth-family      → auth-family-svc
# secret/data/{env}/cn/shared/postgres-notification     → notification-svc
# secret/data/{env}/cn/shared/postgres-credit           → credit-sub-ad-svc
# secret/data/{env}/cn/shared/postgres-audit            → audit-svc
# secret/data/{env}/os/shared/postgres-auth-family      → auth-family-svc (eks-os)
# secret/data/{env}/os/shared/postgres-ai-dispatch      → ai-dispatch-svc (eks-os，Mongo 见 mongodb-ai-dispatch)

# --- 连接字段（应用 env）---
POSTGRES_HOST=postgresql.dev.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=baobao
POSTGRES_USER=baobao
POSTGRES_PASSWORD=REPLACE_ME

# --- Bitnami existingSecret 兼容字段（ESO / SealedSecret 同步用）---
postgres-password=REPLACE_ME
password=REPLACE_ME
