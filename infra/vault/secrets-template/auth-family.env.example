# auth-family-svc 凭据模板
# Vault path: secret/data/{env}/{region}/auth-family/{provider}
# 复制为本地 .env 时使用占位值，勿提交真实密钥

# --- aliyun-sms ---
# path: .../auth-family/aliyun-sms
# 当 SMS_PROVIDER=aliyun 时必填（Staging 切真实短信见 services/auth-family-svc/README.md）
ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_ME
ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_ME
ALIYUN_SMS_SIGN_NAME=REPLACE_ME
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=REPLACE_ME
ALIYUN_SMS_REGION=cn-hangzhou

# --- sms provider（Deployment env，非 Vault 密钥）---
# SMS_PROVIDER=mock|aliyun  （Staging 默认 mock）
# MOCK_SMS_FIXED_CODE=123456   # mock 模式：所有手机号固定码
# SMS_TEST_PHONES=13800138001:123456,13800138002:123456,13800138003:123456
#   aliyun 模式：白名单号码固定码且跳过真实短信；非白名单走阿里云发码

# --- apple-sign-in (服务端校验 identityToken) ---
# path: .../auth-family/apple-sign-in
# identityToken JWKS 校验仅需 Deployment env（非 Vault）：
#   APPLE_AUTH_MOCK=false
#   APPLE_BUNDLE_ID=com.babycamera.app
# 以下 .p8 凭据用于 V1.1+ 服务端换 token，非 JWKS 校验必需：
APPLE_TEAM_ID=REPLACE_ME
APPLE_KEY_ID=REPLACE_ME
APPLE_CLIENT_ID=REPLACE_ME
APPLE_PRIVATE_KEY_PEM=|
  -----BEGIN PRIVATE KEY-----
  REPLACE_ME
  -----END PRIVATE KEY-----

# --- wechat-open (V1.1) ---
# path: .../auth-family/wechat-open
WECHAT_APP_ID=REPLACE_ME
WECHAT_APP_SECRET=REPLACE_ME

# --- baidu-pan-oauth (服务端 OAuth client，用户 token 落库) ---
# path: .../auth-family/baidu-pan-oauth
BAIDU_PAN_APP_KEY=REPLACE_ME
BAIDU_PAN_SECRET_KEY=REPLACE_ME
BAIDU_PAN_REDIRECT_URI=https://api-cn.example.com/v1/backup/baidu/callback

# --- jwt-signing ---
# path: .../auth-family/jwt-signing
JWT_SIGNING_KEY=REPLACE_ME_BASE64
JWT_REFRESH_SIGNING_KEY=REPLACE_ME_BASE64

# --- staging QA 固定短信码（非 Vault 密钥；Deployment env）---
# 与 tests/accounts/test-accounts.yaml sms_code_mock 对齐
# MOCK_SMS_FIXED_CODE=123456
