# ai-dispatch-svc 凭据模板
# Vault path: secret/data/{env}/{region}/ai-dispatch/{provider}

# --- bytedance (Seedream / Jimeng / Seedance) ---
# path: .../ai-dispatch/bytedance
BYTEDANCE_API_KEY=REPLACE_ME
BYTEDANCE_API_SECRET=REPLACE_ME
BYTEDANCE_ENDPOINT=https://visual.volcengineapi.com
SEEDREAM_MODEL_ID=REPLACE_ME
JIMENG_MODEL_ID=REPLACE_ME
SEEDANCE_MODEL_ID=REPLACE_ME

# --- alibaba-dashscope (通义万相) ---
# path: .../ai-dispatch/alibaba-dashscope
DASHSCOPE_API_KEY=REPLACE_ME
WANXIANG_MODEL_ID=wanx-v1

# --- openai (OS) ---
# path: .../ai-dispatch/openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_ORG_ID=REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_NO_TRAINING_HEADER=1

# --- google (OS — Nano Banana / Imagen) ---
# path: .../ai-dispatch/google
GOOGLE_API_KEY=REPLACE_ME
GOOGLE_PROJECT_ID=REPLACE_ME
GOOGLE_LOCATION=us-central1

# --- model-filing (算法备案号，T7.1) ---
# path: .../ai-dispatch/model-filing
# JSON 或 KEY=VALUE 形式存储各模型备案号
FILING_SEEDREAM=REPLACE_ME
FILING_WANXIANG=REPLACE_ME
FILING_JIMENG=REPLACE_ME
FILING_SEEDANCE=REPLACE_ME
