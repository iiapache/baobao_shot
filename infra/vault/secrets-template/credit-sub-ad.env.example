# credit-sub-ad-svc 凭据模板

# --- apple-iap ---
# path: secret/data/{env}/{region}/credit-sub-ad/apple-iap
APPLE_IAP_ISSUER_ID=REPLACE_ME
APPLE_IAP_KEY_ID=REPLACE_ME
APPLE_IAP_BUNDLE_ID=com.example.babycamera
APPLE_IAP_PRIVATE_KEY_PEM=|
  -----BEGIN PRIVATE KEY-----
  REPLACE_ME
  -----END PRIVATE KEY-----
APPLE_IAP_SHARED_SECRET=REPLACE_ME

# --- pangle 穿山甲 Server 验签 ---
# path: .../credit-sub-ad/pangle
PANGLE_SECURITY_KEY=REPLACE_ME
PANGLE_APP_ID=REPLACE_ME

# --- gdt 优量汇 Server 验签 ---
# path: .../credit-sub-ad/gdt
GDT_SECRET_KEY=REPLACE_ME
GDT_APP_ID=REPLACE_ME

# --- admob SSV (OS) ---
# path: .../credit-sub-ad/admob
ADMOB_SSV_PUBLIC_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_APP_ID=REPLACE_ME
