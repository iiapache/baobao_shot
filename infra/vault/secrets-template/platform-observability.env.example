# 平台可观测性凭据模板

# --- sentry ---
# path: secret/data/{env}/global/platform/sentry
SENTRY_DSN_BACKEND=REPLACE_ME
SENTRY_DSN_IOS=REPLACE_ME
SENTRY_AUTH_TOKEN=REPLACE_ME
SENTRY_ORG=REPLACE_ME
SENTRY_PROJECT_BACKEND=babycamera-api
SENTRY_PROJECT_IOS=babycamera-ios
SENTRY_ENVIRONMENT=production

# --- bugly ---
# path: secret/data/{env}/global/platform/bugly
# 主要为端侧；符号表 upload 如有 CI 脚本则使用以下占位
BUGLY_APP_ID=REPLACE_ME
BUGLY_APP_KEY=REPLACE_ME
BUGLY_SYMBOL_UPLOAD_TOKEN=REPLACE_ME
