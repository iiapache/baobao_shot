# audit-svc 凭据模板

# --- aliyun-green (内容安全 CSP) ---
# path: secret/data/{env}/cn/audit/aliyun-green
ALIYUN_GREEN_ACCESS_KEY_ID=REPLACE_ME
ALIYUN_GREEN_ACCESS_KEY_SECRET=REPLACE_ME
ALIYUN_GREEN_REGION=cn-shanghai
ALIYUN_GREEN_ENDPOINT=
ALIYUN_GREEN_OBJECT_URL_PREFIX=https://oss-mock.example.com
ALIYUN_GREEN_IMAGE_SCENE=porn,terrorism,ad,qrcode,live
ALIYUN_GREEN_TEXT_SCENE=antispam

# --- aws-rekognition (OS，可选) ---
# path: .../audit/aws-rekognition
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=ap-southeast-1

# --- cloudflare (OS，可选) ---
# path: .../audit/cloudflare
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
CLOUDFLARE_API_TOKEN=REPLACE_ME
