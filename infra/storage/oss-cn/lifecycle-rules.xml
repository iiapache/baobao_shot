<?xml version="1.0" encoding="UTF-8"?>
<!-- 阿里云 OSS 生命周期 — baby-camera-cn
     桶：oss://baby-camera-cn/
     参考：docs/design-backend.md §4.4
     注意：OSS Expiration 最小粒度为 1 天；ai-tmp 按 24h 业务要求映射为 1 天过期 -->
<LifecycleConfiguration>
  <Rule>
    <ID>expire-ai-tmp-24h</ID>
    <Prefix>ai-tmp/</Prefix>
    <Status>Enabled</Status>
    <Expiration>
      <Days>1</Days>
    </Expiration>
    <AbortMultipartUpload>
      <Days>1</Days>
    </AbortMultipartUpload>
  </Rule>

  <Rule>
    <ID>expire-ai-out-30d</ID>
    <Prefix>ai-out/</Prefix>
    <Status>Enabled</Status>
    <Expiration>
      <Days>30</Days>
    </Expiration>
    <AbortMultipartUpload>
      <Days>7</Days>
    </AbortMultipartUpload>
  </Rule>

  <Rule>
    <ID>family-long-term-ia-transition</ID>
    <Prefix>family/</Prefix>
    <Status>Enabled</Status>
    <!-- family/ 长期保存，不设 Expiration；超过 90 天转低频访问降低存储成本 -->
    <Transition>
      <Days>90</Days>
      <StorageClass>IA</StorageClass>
    </Transition>
    <Transition>
      <Days>365</Days>
      <StorageClass>Archive</StorageClass>
    </Transition>
  </Rule>

  <Rule>
    <ID>avatar-long-term</ID>
    <Prefix>avatar/</Prefix>
    <Status>Enabled</Status>
    <Transition>
      <Days>180</Days>
      <StorageClass>IA</StorageClass>
    </Transition>
  </Rule>

  <Rule>
    <ID>caption-cache-7d</ID>
    <Prefix>caption-cache/</Prefix>
    <Status>Enabled</Status>
    <Expiration>
      <Days>7</Days>
    </Expiration>
  </Rule>
</LifecycleConfiguration>
