# T7.6 性能压测环境变量（复制为 perf.env）
BASE_URL=http://localhost:18080
E2E_REGION=cn
E2E_APP_VERSION=1.0.0-staging
E2E_DEVICE_ID=qa-device-iphone12-001
E2E_ADMIN_PHONE=13800138001
E2E_ADMIN_CODE=123456
PERF_FAMILY_ID=fam_e2e_001

# Feed 压测
PERF_FEED_REQUESTS=50
PERF_FEED_WARMUP=5
PERF_FEED_P95_BUDGET_MS=500

# AI mock 延迟统计
PERF_AI_IMAGE_SAMPLES=10
PERF_AI_VIDEO_SAMPLES=5
PERF_AI_IMAGE_P95_BUDGET_SEC=60
PERF_AI_VIDEO_P95_BUDGET_SEC=300
PERF_AI_INPUT_KEY=ai-tmp/usr_e2e_admin/e2e-input.heic
PERF_AI_POLL_INTERVAL_SEC=1
PERF_AI_POLL_MAX=120
# mock 注入额外延迟（毫秒，0=仅测 mock 原生响应）
PERF_AI_INJECT_DELAY_MS=0

# iOS 端侧 stub（benchmark-ios-device.sh）
PERF_IOS_DEVICE_MODEL=iPhone 12
PERF_IOS_STUB_CAMERA_MS=720
PERF_IOS_STUB_EDITOR_MS=420
