{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/families/.+/babies",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "OK",
      "message": "ok",
      "requestId": "req_mock_baby_create",
      "data": {
        "babyId": "bb_e2e_001",
        "familyId": "fam_e2e_001",
        "name": "{{jsonPath request.body '$.name'}}",
        "birthday": "{{jsonPath request.body '$.birthday'}}",
        "gender": "{{jsonPath request.body '$.gender'}}",
        "timezone": "Asia/Shanghai",
        "avatarUrl": null
      }
    },
    "transformers": ["response-template"]
  }
}
