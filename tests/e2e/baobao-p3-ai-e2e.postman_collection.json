              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{adminPhone}}\",\n  \"code\": \"{{adminCode}}\"\n}" },
            "url": "{{baseUrl}}/v1/auth/phone/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
