# P1 E2E 环境变量（复制为 e2e.env）
# 对齐 tests/accounts/test-accounts.yaml

BASE_URL=http://localhost:18080
E2E_REGION=cn
E2E_APP_VERSION=1.0.0-staging
E2E_DEVICE_ID=qa-device-iphone12-001

# 管理员（创建家庭 / 邀请 / 宝宝 / 注销）
E2E_ADMIN_PHONE=13800138001
E2E_ADMIN_CODE=123456

# 家庭成员（通过邀请码加入）
E2E_MEMBER_PHONE=13800138002
E2E_MEMBER_CODE=123456

# Staging 模式（可选）
# BASE_URL=https://staging-api-cn.example.com
# STAGING_RESOLVE=staging-api-cn.example.com:443:<LB-IP>
