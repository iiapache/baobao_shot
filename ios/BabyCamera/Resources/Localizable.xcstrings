    "onboarding.consent.policy_summary": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 您确认是所添加儿童的监护人或已获得监护人授权。\n2. 您同意本 App 在本地及经您授权的云备份中存储儿童照片与成长记录。\n3. 未经您明确授权，儿童照片不会用于广告或 AI 模型训练。\n4. 您可随时在设置中撤回同意或申请删除相关数据。\n5. 同意版本号为 child_consent_v1；版本更新后需重新同意。"
          }
        }
      }
    },
