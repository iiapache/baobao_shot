// 生产环境 API / WebSocket 基址（Release 默认）。Debug / Staging 在各自 xcconfig 中覆盖。
API_BASE_URL_CN = https:/$()/api-cn.babygrowth.app
API_BASE_URL_OS = https:/$()/api-os.babygrowth.app
WS_BASE_URL_CN = wss:/$()/ws-cn.babygrowth.app
WS_BASE_URL_OS = wss:/$()/ws-os.babygrowth.app
LEGAL_BASE_URL = https:/$()/www.babycamera.app/legal
