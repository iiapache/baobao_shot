// Debug 默认 stub IAP（mock JWS + 本地 Mock API）；真机 StoreKit 沙盒联调改为 YES 后 Clean Build
IAP_USE_STOREKIT = NO
ATS_ALLOWS_LOCAL_NETWORKING = YES
LEGAL_BASE_URL = http:/$()/localhost:8765/compliance/legal
