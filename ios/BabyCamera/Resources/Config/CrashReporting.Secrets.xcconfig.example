// 复制为 CrashReporting.Secrets.xcconfig（已 gitignore），或在 CI 中注入同名 build setting。
// Vault: secret/{env}/cn/shared/sentry → ios_dsn
// Vault: secret/{env}/cn/global/platform/bugly → app_id

SENTRY_DSN = https://YOUR_KEY@oORG.ingest.sentry.io/PROJECT
BUGLY_APP_ID = YOUR_BUGLY_APP_ID
APP_ENVIRONMENT = staging
CRASH_REPORTING_ENABLED = YES
