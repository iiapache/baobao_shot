# fastlane match — 证书与 Provisioning Profile 加密 Git 仓库
# 首次初始化见 fastlane/README.md §「match 初始化」

git_url(ENV.fetch("MATCH_GIT_URL", "git@gitlab.com:YOUR_ORG/babycamera-certificates.git"))

storage_mode("git")

type("appstore")

# 主 App + Widget Extension（Archive 需两者 profile）
app_identifier([
  "com.babycamera.app",
  "com.babycamera.app.widget"
])

username(ENV.fetch("FASTLANE_USER", "apple-id@example.com"))

team_id(ENV.fetch("FASTLANE_TEAM_ID", "YOUR_TEAM_ID"))

# CI 只读拉取；本地首次生成证书时传 --readonly false
readonly(ENV.fetch("CI", "false") == "true")

# 加速 clone（大仓库可选）
clone_branch_directly(true)

# 默认分支名，与证书仓库一致
git_branch(ENV.fetch("MATCH_GIT_BRANCH", "master"))

# 加密密码来自 MATCH_PASSWORD 环境变量（勿写入本文件）
