# Fastlane Appfile — 宝宝成长相机
# 敏感项通过环境变量注入，勿提交真实 Team ID / Apple ID

app_identifier(ENV.fetch("FASTLANE_APP_IDENTIFIER", "com.babycamera.app"))

# Apple Developer Portal 登录邮箱（match 初始化时使用）
# apple_id(ENV["FASTLANE_USER"])

# Apple Developer Team ID（10 位字母数字）
team_id(ENV.fetch("FASTLANE_TEAM_ID", "YOUR_TEAM_ID"))

# App Store Connect Team ID（多团队账号时填写，通常与 team_id 相同）
