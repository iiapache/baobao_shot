# Fastlane lanes — 宝宝成长相机 iOS
# 本地: cd ios && bundle exec fastlane <lane>
# CI:   macOS runner 或 Xcode Cloud workflow 调用

default_platform(:ios)

platform :ios do
  # MR / 本地单测入口
  desc "Run unit tests (xcodebuild test)"
  lane :test do
    # T0.13 创建 Xcode 工程后取消注释并调整 scheme
    # scan(
    #   scheme: "BabyCamera",
    #   device: "iPhone 16",
    #   clean: true,
    #   code_coverage: true,
    #   output_directory: "./fastlane/test_output",
    #   fail_build: true
    # )

    UI.message(">>> fastlane test — 占位模式（无 Xcode 工程）")
    UI.message(">>> T0.13 后启用 scan + xcodebuild test")
    UI.message(">>> GitLab MR: test:ios job 在 Linux 验证本 lane 存在")
    UI.message(">>> 正式 CI: macOS runner 执行 bundle exec fastlane test")

    if ENV["CI"]
      sh("echo 'CI environment detected — skipping xcodebuild on non-macOS runner'")
    end
  end

  # TestFlight 内测（T7.12）
  # 前置：
  #   1. T0.12 Apple Developer 账号 + App Store Connect API Key（或 FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD）
  #   2. T0.13 Xcode 工程 scheme `BabyCamera` 可 archive
  #   3. fastlane match 证书仓库（GitLab private repo）+ MATCH_PASSWORD
  #   4. 冒烟门禁：tests/e2e/smoke-critical-path.sh 全绿
  #
  # match 首次初始化（仅运维/本地一次，勿提交 .p12 / .mobileprovision）：
  #   bundle exec fastlane match appstore --readonly false   # 生成 Distribution 证书
  #   bundle exec fastlane match development --readonly false # 可选：开发调试
  # 日常 CI / 本地只读拉取：
  #   bundle exec fastlane match appstore --readonly
  #
  # 环境变量（GitLab CI Variables 推荐）：
  #   MATCH_PASSWORD              match 加密仓库密码
  #   MATCH_GIT_BASIC_AUTHORIZATION Base64(user:token) 拉 match 仓库
  #   APP_STORE_CONNECT_API_KEY   API Key JSON 路径或内容
  #   FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT = 120
  desc "Build and upload to TestFlight (T7.12)"
  lane :beta do
    scheme = ENV.fetch("BABYCAMERA_SCHEME", "BabyCamera")
    configuration = ENV.fetch("BABYCAMERA_CONFIGURATION", "Release")
    export_method = "app-store"

    unless ENV["CI"] == "true" || File.exist?("../BabyCamera.xcodeproj")
      UI.important(">>> beta lane 占位模式：未检测到 Xcode 工程，跳过签名与上传")
      UI.important(">>> 就绪后取消下方注释并配置 match + App Store Connect")
      UI.important(">>> 文档：docs/qa/TESTFLIGHT_BETA_PLAN.md")
      next
    end

    # ── 1. 同步签名（match）────────────────────────────────────
    # match(
    #   type: "appstore",
    #   readonly: is_ci,
    #   app_identifier: ["app.babycamera"],
    #   git_url: ENV["MATCH_GIT_URL"],           # e.g. git@gitlab.com:org/certificates.git
    #   git_branch: ENV.fetch("MATCH_GIT_BRANCH", "master"),
    #   clone_branch_directly: true
    # )

    # ── 2. 递增 build 号（可选，也可用 agvtool / CI_PIPELINE_IID）──
    # increment_build_number(
    #   xcodeproj: "BabyCamera.xcodeproj",
    #   build_number: ENV["CI_PIPELINE_IID"]
    # )

    # ── 3. Archive ────────────────────────────────────────────
    # gym(
    #   scheme: scheme,
    #   configuration: configuration,
    #   export_method: export_method,
    #   output_directory: "./build",
    #   output_name: "BabyCamera.ipa",
    #   include_bitcode: false,
    #   include_symbols: true,
    #   clean: true
    # )

    # ── 4. 上传 TestFlight ────────────────────────────────────
    # upload_to_testflight(
    #   ipa: "./build/BabyCamera.ipa",
    #   skip_waiting_for_build_processing: false,
    #   distribute_external: false,          # 先 internal；External 见 TESTFLIGHT_BETA_PLAN
    #   changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "T7.12 内测构建"),
    #   beta_app_description: "宝宝成长相机 TestFlight 内测",
    #   beta_app_feedback_email: ENV.fetch("TESTFLIGHT_FEEDBACK_EMAIL", "beta@example.com"),
    #   notify_external_testers: false,
    #   api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    # )

    UI.message(">>> fastlane beta — 占位完成（match + gym + upload_to_testflight 已就绪，取消注释后生效）")
    UI.message(">>> match: bundle exec fastlane match appstore --readonly")
    UI.message(">>> 内测计划: docs/qa/TESTFLIGHT_BETA_PLAN.md")
  end

  # App Store 提审（T7.13）
  desc "Submit to App Store"
  lane :release do
    UI.user_error!("release lane 待上架流程就绪后启用")
  end
end
