# Fastlane lanes — 宝宝成长相机 iOS
# 本地: cd ios && bundle install && bundle exec fastlane <lane>
# 文档: docs/qa/TESTFLIGHT_BUILD_CHECKLIST.md

default_platform(:ios)

APP_IDENTIFIERS = [
  "com.babycamera.app",
  "com.babycamera.app.widget"
].freeze

def macos?
  RUBY_PLATFORM.match?(/darwin/)
end

def xcode_ready?
  File.exist?("BabyCamera.xcodeproj")
end

def ci?
  ENV["CI"] == "true"
end

def skip_upload?
  ENV["SKIP_UPLOAD"] == "true"
end

def skip_match?
  ENV["SKIP_MATCH"] == "true"
end

def team_id
  ENV["FASTLANE_TEAM_ID"] || CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
end

def resolve_team_id!
  id = team_id
  UI.user_error!("缺少 FASTLANE_TEAM_ID（或 Appfile team_id）。见 docs/qa/TESTFLIGHT_BUILD_CHECKLIST.md") if id.nil? || id.empty? || id == "YOUR_TEAM_ID"
  id
end

def resolve_scheme
  ENV.fetch("BABYCAMERA_SCHEME", "BabyCamera-Staging")
end

def resolve_configuration
  ENV.fetch("BABYCAMERA_CONFIGURATION", "Staging")
end

def ensure_macos_for_build!
  return if macos?

  UI.user_error!("iOS 构建需在 macOS + Xcode 环境执行")
end

def ensure_signing_env!
  missing = []
  missing << "MATCH_PASSWORD" if ENV["MATCH_PASSWORD"].to_s.empty?
  missing << "MATCH_GIT_URL" if ENV["MATCH_GIT_URL"].to_s.empty? || ENV["MATCH_GIT_URL"].include?("YOUR_ORG")
  missing << "FASTLANE_TEAM_ID" if team_id.nil? || team_id.empty? || team_id == "YOUR_TEAM_ID"

  return if missing.empty?

  UI.user_error!(
    "签名环境未就绪，缺少: #{missing.join(', ')}。\n" \
    "先运行: ./scripts/verify-signing.sh\n" \
    "文档: docs/qa/TESTFLIGHT_BUILD_CHECKLIST.md"
  )
end

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
    ENV["FASTLANE_XCODE_LIST_TIMEOUT"] ||= "120"
  end

  desc "Run unit tests (scan / xcodebuild test)"
  lane :test do
    unless macos? && xcode_ready?
      UI.message(">>> test lane — 非 macOS 或无 Xcode 工程，跳过 xcodebuild")
      UI.message(">>> macOS 验证: cd ios && bundle exec fastlane test")
      next
    end

    scan(
      workspace: "BabyCamera.xcworkspace",
      scheme: ENV.fetch("BABYCAMERA_SCHEME", "BabyCamera"),
      device: ENV.fetch("SCAN_DEVICE", "iPhone 16"),
      clean: true,
      code_coverage: true,
      output_directory: "./fastlane/test_output",
      fail_build: true
    )
  end

  desc "Check signing prerequisites (wraps scripts/verify-signing.sh)"
  lane :verify_signing do
    sh("./scripts/verify-signing.sh")
  end

  desc "Sync App Store signing assets via match (readonly in CI)"
  lane :sync_signing do
    ensure_macos_for_build!
    ensure_signing_env!

    resolved_team = resolve_team_id!

    update_project_team(
      path: "BabyCamera.xcodeproj",
      teamid: resolved_team
    )

    match(
      type: "appstore",
      readonly: ci? || ENV.fetch("MATCH_READONLY", "true") == "true",
      app_identifier: APP_IDENTIFIERS,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: ENV.fetch("MATCH_GIT_BRANCH", "master"),
      clone_branch_directly: true
    )
  end

  desc "Build Release/Staging IPA (match + gym)"
  lane :build_ipa do
    ensure_macos_for_build!
    ensure_signing_env!

    scheme = resolve_scheme
    configuration = resolve_configuration
    output_name = ENV.fetch("IPA_OUTPUT_NAME", "BabyCamera.ipa")

    sync_signing unless skip_match?

    if ENV["CI_PIPELINE_IID"]
      increment_build_number(
        xcodeproj: "BabyCamera.xcodeproj",
        build_number: ENV["CI_PIPELINE_IID"]
      )
    end

    gym(
      workspace: "BabyCamera.xcworkspace",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      output_directory: "./build",
      output_name: output_name,
      include_bitcode: false,
      include_symbols: true,
      clean: true,
      silent: false
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.success(">>> IPA 已生成: #{ipa_path}")
    ipa_path
  end

  desc "Build and upload to TestFlight (ENV-02)"
  lane :beta do
    unless macos? && xcode_ready?
      UI.important(">>> beta lane — 非 macOS 或无 Xcode 工程，跳过构建")
      UI.important(">>> 证书就绪后在 macOS 执行: cd ios && bundle exec fastlane beta")
      UI.important(">>> 文档: docs/qa/TESTFLIGHT_BUILD_CHECKLIST.md")
      next
    end

    ipa_path = build_ipa

    next if skip_upload?

    api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    api_key_json = ENV["APP_STORE_CONNECT_API_KEY"]

    upload_options = {
      ipa: ipa_path,
      skip_waiting_for_build_processing: ENV.fetch("SKIP_WAIT_FOR_PROCESSING", "false") == "true",
      distribute_external: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "宝宝相机 TestFlight 内测构建"),
      beta_app_description: "宝宝成长相机 TestFlight 内测",
      beta_app_feedback_email: ENV.fetch("TESTFLIGHT_FEEDBACK_EMAIL", "beta@example.com"),
      notify_external_testers: false
    }

    if api_key_path && !api_key_path.empty?
      upload_options[:api_key_path] = api_key_path
    elsif api_key_json && !api_key_json.empty?
      upload_options[:api_key] = app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
        key_content: api_key_json,
        is_key_content_base64: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64", "false") == "true"
      )
    else
      UI.important(">>> 未配置 App Store Connect API Key，将尝试 Apple ID 上传（需 FASTLANE_SESSION 或应用专用密码）")
    end

    upload_to_testflight(upload_options)
    UI.success(">>> TestFlight 上传完成")
  end

  desc "Build IPA only (no TestFlight upload)"
  lane :build_only do
    ENV["SKIP_UPLOAD"] = "true"
    beta
  end

  desc "Submit to App Store (T7.13 — not enabled)"
  lane :release do
    UI.user_error!("release lane 待上架流程就绪后启用")
  end
end
